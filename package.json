{
  "name": "react-page-builder-workspace",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @page-builder/web",
    "build": "npm run build --workspace @page-builder/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "preview": "npm run preview --workspace @page-builder/web",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "lucide-react": "^1.66.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1"
  }
}
