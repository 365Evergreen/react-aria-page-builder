{
  "name": "react-page-builder-workspace",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @page-builder/web",
    "build": "npm run build --workspace @page-builder/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @page-builder/ui",
    "preview": "npm run preview --workspace @page-builder/web"
  },
  "dependencies": {
    "lucide-react": "^1.66.0"
  }
}
